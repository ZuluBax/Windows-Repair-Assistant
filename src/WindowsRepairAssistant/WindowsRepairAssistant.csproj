<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WindowsRepairAssistant</AssemblyName>
    <RootNamespace>WindowsRepairAssistant</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/IconGenerator; edit the generator, not the .ico. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Windows Repair Assistant</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as a WPF resource too, so the window title bar uses it. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsRepairAssistant.Core\WindowsRepairAssistant.Core.csproj" />
  </ItemGroup>

</Project>
