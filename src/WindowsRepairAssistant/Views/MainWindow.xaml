<Window x:Class="WindowsRepairAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsRepairAssistant.ViewModels"
        xmlns:views="clr-namespace:WindowsRepairAssistant.Views"
        Title="Windows Repair Assistant"
        Icon="/Assets/app.ico"
        Width="880" Height="800" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <views:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />

        <!-- Welcome screen: what will run. -->
        <DataTemplate x:Key="PlannedStepTemplate" DataType="{x:Type vm:StepViewModel}">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentSubtleBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,2,0,0">
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource TextSecondaryBrush}" /><Run Text="{Binding DisplayName, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Progress and results: each step with a status badge. Status is always shown as text as well as colour/icon. -->
        <DataTemplate x:Key="StepStatusTemplate" DataType="{x:Type vm:StepViewModel}">
            <Grid Margin="0,0,0,16" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding StatusText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top"
                        Background="{StaticResource NeutralSubtleBrush}">
                    <Grid>
                        <TextBlock x:Name="Number" Text="{Binding Number}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="14" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource TextSecondaryBrush}" /><Run Text="{Binding DisplayName, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border x:Name="Pill" CornerRadius="11" Padding="10,3" Background="{StaticResource NeutralSubtleBrush}" HorizontalAlignment="Right">
                        <TextBlock x:Name="PillText" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource SecondaryText}" FontSize="12"
                               HorizontalAlignment="Right" Margin="0,4,2,0" />
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Number" Property="Foreground" Value="White" />
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CompletedWithIssues">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSubtleBrush}" />
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarningSubtleBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource ErrorSubtleBrush}" />
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource ErrorSubtleBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE738;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Small icon + text callout used for notes on the welcome screen. -->
        <Style x:Key="NoteIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,12,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MaxWidth="780" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE90F;" FontSize="26" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Windows Repair Assistant" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Check and repair Windows system files with one simple process." Style="{StaticResource SubtitleText}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- ============================== WELCOME ============================== -->
            <StackPanel Grid.Row="1" Visibility="{Binding Screen, Converter={StaticResource EnumToVisibility}, ConverterParameter=Welcome}">

                <Border Padding="14,12" CornerRadius="8" Margin="0,0,0,16"
                        Visibility="{Binding StartupNotice, Converter={StaticResource NotEmptyToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartupNoticeIsWarning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource NoteIcon}" Text="&#xE946;" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding StartupNotice}" Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="What this does" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,20"
                                   Text="Windows Repair Assistant runs four repair tools that are built into Windows, one after another. They check whether any Windows system files are damaged or missing and repair them where possible. Nothing extra is installed, and no information leaves your computer." />

                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource PlannedStepTemplate}" Focusable="False" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,18" />

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource NoteIcon}" Text="&#xE823;" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Text="This can take some time, often 20 to 60 minutes and sometimes longer. You can keep using your computer, but please don't shut it down or restart it until the repair has finished." />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource NoteIcon}" Text="&#xE774;" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Text="An internet connection may be needed. If Windows finds damage, the repair step (DISM RestoreHealth) may download replacement files from Windows Update." />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Button Content="START REPAIR" Style="{StaticResource HeroButton}" HorizontalAlignment="Center" Margin="0,28,0,0"
                        Command="{Binding StartRepairCommand}"
                        AutomationProperties.Name="Start repair" />
            </StackPanel>

            <!-- ============================== RUNNING ============================== -->
            <StackPanel Grid.Row="1" Visibility="{Binding Screen, Converter={StaticResource EnumToVisibility}, ConverterParameter=Running}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentStepNumberText}" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding CurrentStepTitle}" Style="{StaticResource SectionHeading}" FontSize="22" Margin="0,4,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding CurrentStepDescription}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20" />

                        <ProgressBar Style="{StaticResource FluentProgressBar}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue, Mode=OneWay}"
                                     AutomationProperties.Name="Current step progress" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Status:" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CurrentStatusText}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Overall progress" Style="{StaticResource SectionHeading}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{Binding OverallStatusText}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepStatusTemplate}" Focusable="False" />

                        <Expander x:Name="DetailsExpander" Header="Show technical details" Style="{StaticResource DetailsExpander}" Margin="0,4,0,0">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Background="#FAFAFA">
                                <ListBox x:Name="OutputList" ItemsSource="{Binding OutputLines}" Height="200" BorderThickness="0" Background="Transparent"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Technical output from the repair tools" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <DockPanel Margin="4,16,0,0">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource NoteIcon}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Text="Please don't close this window or restart your computer until the repair has finished. You can minimise it and keep working." />
                </DockPanel>
            </StackPanel>

            <!-- ============================== RESULTS ============================== -->
            <StackPanel Grid.Row="1" Visibility="{Binding Screen, Converter={StaticResource EnumToVisibility}, ConverterParameter=Results}">

                <Border CornerRadius="8" Padding="20,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Outcome}" Value="NoProblemsFound">
                                    <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Outcome}" Value="ProblemsRepaired">
                                    <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Outcome}" Value="ProblemsRemain">
                                    <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Outcome}" Value="Incomplete">
                                    <Setter Property="Background" Value="{StaticResource ErrorSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Outcome}" Value="NoProblemsFound">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Outcome}" Value="ProblemsRepaired">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Outcome}" Value="ProblemsRemain">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Outcome}" Value="Incomplete">
                                            <Setter Property="Text" Value="&#xEA39;" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Text="Repair finished" Style="{StaticResource EyebrowText}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ResultHeadline}" Style="{StaticResource SectionHeading}" Margin="0,2,0,0"
                                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.HeadingLevel="Level2" />
                            <ItemsControl ItemsSource="{Binding ResultDetails}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource BodyText}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding TotalDurationText}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Restart choice. Only reachable on this screen, i.e. never while DISM/SFC is running. -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Restart" Style="{StaticResource SectionHeading}" FontSize="16" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                   Visibility="{Binding RestartRecommended, Converter={StaticResource BoolToVisibility}}"
                                   Text="A restart is recommended so that Windows can finish applying the repairs." />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                   Visibility="{Binding RestartRecommended, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                   Text="A restart is not required, but you can restart now if you like." />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                    Visibility="{Binding ShowRestartChoices, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="RESTART COMPUTER NOW" Style="{StaticResource PrimaryButton}" Command="{Binding RestartNowCommand}"
                                    AutomationProperties.Name="Restart computer now" />
                            <Button Content="RESTART LATER" Style="{StaticResource SecondaryButton}" Command="{Binding RestartLaterCommand}" Margin="12,0,0,0"
                                    AutomationProperties.Name="Restart later" />
                        </StackPanel>

                        <TextBlock Text="Restarting…" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,16,0,0"
                                   Visibility="{Binding IsRestarting, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding RestartDeferred, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding RestartLaterMessage}" Style="{StaticResource BodyText}" AutomationProperties.LiveSetting="Polite" />
                            <Button Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="100" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Results for each step" Style="{StaticResource SectionHeading}" FontSize="16" Margin="0,0,0,16"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepStatusTemplate}" Focusable="False" />

                        <Border Background="{StaticResource WarningSubtleBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                Visibility="{Binding LogProblem, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock Text="{Binding LogProblem}" Style="{StaticResource SecondaryText}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ViewLogCommand}" FontWeight="Normal"
                                    AutomationProperties.Name="View log"
                                    Visibility="{Binding LogFilePath, Converter={StaticResource NotEmptyToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" Margin="0,0,8,0" />
                                    <TextBlock Text="View log" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogFolderCommand}" FontWeight="Normal" Margin="12,0,0,0"
                                    AutomationProperties.Name="Open log folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,0,8,0" />
                                    <TextBlock Text="Open log folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="0,24,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding OpenLogFolderCommand}"
                        AutomationProperties.Name="Open log folder"
                        Visibility="{Binding Screen, Converter={StaticResource EnumToVisibility}, ConverterParameter=Welcome}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Open log folder" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center">
                    <Run Text="Version" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text="  ·  Free · No ads · No tracking. Uses Microsoft's built-in DISM and SFC tools." />
                </TextBlock>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
