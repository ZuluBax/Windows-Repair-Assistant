<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained single-file release build: users do not need .NET installed. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF ships native DLLs that must be bundled into the single exe and extracted at runtime. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF does not support trimming; leave it off to avoid runtime reflection failures. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
